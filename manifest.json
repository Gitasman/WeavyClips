{
  "manifest_version": 3,
  "name": "Weavy Clips",
  "version": "2.4.1",
  "description": "Clipboard and reusable clip manager for Weavy",
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "unlimitedStorage",
    "tabs",
    "debugger",
    "sidePanel"
  ],
  "host_permissions": [
    "*://app.weavy.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://app.weavy.ai/*"
      ],
      "js": [
        "appearance.js",
        "factory.js",
        "clips.js",
        "backup.js",
        "ui.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "appearance.css",
        "ui.css"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Weavy Clips"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "options.html"
  }
}
